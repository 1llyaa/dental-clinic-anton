---
import Base from '../layouts/Base.astro';
import HoursTable from '../components/HoursTable.astro';
import PageHero from '../components/PageHero.astro';
import { mailHref, site, telHref } from '../data/site';

const rows = [
  { label: 'Adresa', value: site.address },
  { label: 'Telefon', value: site.phone, href: telHref },
  { label: 'E-mail', value: site.email, href: mailHref },
  { label: 'IČO', value: site.ico },
];
---

<Base
  title="Kontakt"
  description={`Adresa, telefon, e-mail a ordinační hodiny zubní ordinace v Lišově. ${site.address}.`}
>
  <PageHero eyebrow="Kontakt" title="Kde nás najdete" />
  <div class="container grid-2 body">
    <div>
      <dl class="rows">
        {rows.map((r) => (
          <div class="row">
            <dt class="label">{r.label}</dt>
            <dd>{r.href ? <a href={r.href}>{r.value}</a> : r.value}</dd>
          </div>
        ))}
      </dl>
      <h2 class="hours-title">Ordinační hodiny</h2>
      <HoursTable />
      <p class="muted urgent">
        Akutní ošetření prosím vždy domluvte telefonicky. Mimo ordinační hodiny se obraťte na zubní
        pohotovost v Českých Budějovicích.
      </p>
    </div>
    <div>
      <div class="map">
        <iframe
          title="Mapa — Lišov"
          src={site.mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer"
        ></iframe>
      </div>
      <p class="map-note">Parkování je možné přímo před ordinací. Vstup je bez schodů.</p>
    </div>
  </div>
</Base>

<style>
  .body {
    padding-top: 44px;
    padding-bottom: 72px;
    gap: 40px;
  }
  .rows {
    margin: 0;
  }
  .row {
    padding: 16px 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .row .label {
    margin-bottom: 4px;
    font-size: 12px;
  }
  dd {
    margin: 0;
    font-size: 18px;
    overflow-wrap: anywhere;
  }
  .hours-title {
    margin: 26px 0 12px;
    font-family: var(--font-head);
    font-weight: 800;
    color: var(--navy);
    font-size: 20px;
  }
  .urgent {
    margin-top: 20px;
    font-size: 16px;
  }
  .map {
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    height: 300px;
    background: var(--placeholder);
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map-note {
    margin-top: 10px;
    font-size: 15px;
    color: var(--subtle);
  }
</style>
