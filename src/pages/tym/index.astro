---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import { team } from '../../data/team';
---

<Base
  title="Tým"
  description="Zubní lékař, dentální hygienistka a zubní asistentka — tým zubní ordinace v Lišově."
>
  <PageHero
    eyebrow="Tým"
    title="Kdo se o vás postará"
    intro="Tři lidé, kteří se v ordinaci potkáte při každé návštěvě. Klikněte na kartu pro podrobný profil."
  />
  <div class="container grid-3 list">
    {team.map((m) => (
      <a href={`/tym/${m.id}/`} class="card member">
        <div class="photo">
          <PhotoSlot src={m.photo} label={m.photoLabel} />
        </div>
        <div class="info">
          <h2 class="name">{m.name}</h2>
          <p class="role">{m.role}</p>
          <span class="more">Profil →</span>
        </div>
      </a>
    ))}
  </div>
</Base>

<style>
  .list {
    padding-top: 44px;
    padding-bottom: 44px;
    gap: 24px;
  }
  .member {
    overflow: hidden;
    color: inherit;
  }
  .photo {
    height: 260px;
    display: flex;
  }
  .info {
    padding: 22px;
  }
  .name {
    margin-bottom: 4px;
    font-family: var(--font-head);
    font-weight: 800;
    color: var(--navy);
    font-size: 20px;
    line-height: 1.3;
  }
  .role {
    margin-bottom: 12px;
    color: var(--cyan);
    font-family: var(--font-head);
    font-weight: 600;
  }
  .more {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
  }
</style>
