---
import Base from '../../layouts/Base.astro';
import { services, type Service } from '../../data/services';

export function getStaticPaths() {
  return services.map((s) => ({ params: { id: s.id }, props: { service: s } }));
}
const { service } = Astro.props as { service: Service };
---

<Base title={service.title} description={`${service.title} — ${service.lead}`}>
  <div class="container wrap">
    <a href="/sluzby/" class="back">
      ← Zpět na služby
    </a>
    <h1 class="title">{service.title}</h1>
    <p class="intro muted">{service.lead}</p>
    <div class="cols">
      <div>
        {service.body && <p class="lead body">{service.body}</p>}
        <h2 class="label">Jak ošetření probíhá</h2>
        <ol class="steps">
          {service.steps.map((st, i) => (
            <li>
              <span class="n" aria-hidden="true">
                {i + 1}
              </span>
              <span class="muted">{st}</span>
            </li>
          ))}
        </ol>
        {!service.body && <p class="note-box todo">Podrobný popis této služby připravujeme.</p>}
      </div>
      <aside class="card price">
        <h2 class="label">Orientační cena</h2>
        <p class="amount">{service.price}</p>
        <p class="muted small">
          Konečnou cenu vždy sdělíme před ošetřením. Část výkonů hradí zdravotní pojišťovna.
        </p>
        <a href="/objednani/" class="btn btn-primary btn-block">
          Objednat se
        </a>
        <a href="/cenik/" class="all">
          Celý ceník
        </a>
      </aside>
    </div>
  </div>
</Base>

<style>
  .wrap {
    padding-top: 32px;
    padding-bottom: 60px;
  }
  .back {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--muted);
  }
  .title {
    margin: 22px 0 8px;
    font-family: var(--font-head);
    font-weight: 800;
    color: var(--navy);
    font-size: clamp(28px, 4.2vw, 42px);
    line-height: 1.12;
  }
  .intro {
    margin-bottom: 36px;
    font-size: 20px;
    max-width: 58ch;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }
  @media (min-width: 760px) {
    .cols {
      grid-template-columns: 1.4fr 0.9fr;
    }
  }
  .body {
    margin-bottom: 20px;
  }
  .label {
    margin-bottom: 14px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps li {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .n {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--bg-tint);
    color: var(--navy);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .todo {
    margin-top: 24px;
  }
  .price {
    padding: 26px;
    align-self: start;
  }
  .price .label {
    margin-bottom: 6px;
  }
  .amount {
    margin-bottom: 20px;
    font-family: var(--font-head);
    font-weight: 800;
    color: var(--navy);
    font-size: 30px;
    line-height: 1.2;
  }
  .small {
    margin-bottom: 22px;
    font-size: 16px;
  }
  .all {
    display: block;
    text-align: center;
    margin-top: 10px;
    font-family: var(--font-head);
    font-weight: 700;
    padding: 12px;
  }
</style>
