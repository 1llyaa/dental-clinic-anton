# Web root — Apache on Wedos NoLimit.
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Wedos' own www/.htaccess internally rewrites every request into
  # /domains/<domain>/, so %{REQUEST_URI} here already carries that prefix.
  # Redirects therefore use $1 (the path relative to this directory) instead.

  # Undo old redirects that leaked the internal prefix into public URLs.
  RewriteCond %{THE_REQUEST} \s/domains/[^/]+/(\S*)\s
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://www.zubnilisov.cz/%1 [L,R=301]

  # One canonical host: apex → www, straight to HTTPS (matches `site` in astro.config.mjs).
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

  # Force HTTPS (enable Let's Encrypt in Wedos admin first). Skipped for local testing.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

  # Hide dotfiles (except .well-known for certificates).
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed build assets never change; HTML must always be revalidated.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # The pages show this content; keep the raw runtime JSON out of
  # search results. (/admin/ sends its own X-Robots-Tag from index.php.)
  <If "%{REQUEST_URI} =~ m#^/data/#">
    Header always set X-Robots-Tag "noindex"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
