{
  "name": "zubni-lisov",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/guard-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:php": "docker build -q -t zubni-lisov-php docker >/dev/null && docker run --rm -v \"$PWD:/app\" -w /app zubni-lisov-php php tests/php/run.php",
    "serve:php": "./scripts/local-server.sh",
    "test:e2e": "tests/e2e/admin-smoke.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
